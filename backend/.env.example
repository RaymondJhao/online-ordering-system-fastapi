# ---------------------------------------------------------------------------
# 複製本檔為 .env 後填入實際值。.env 已列入 .gitignore，不會被提交。
#
# 與舊版 Flask 的差異：SECRET_KEY / JWT_SECRET_KEY 不再有程式內的預設值，
# 缺少或使用弱值時應用程式會「啟動失敗」，而不是默默用 dev 金鑰跑起來。
# 產生金鑰：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# 執行環境：development / testing / production
ENVIRONMENT=development

# --- 安全性（必填，無預設值）---
SECRET_KEY=請用上面的指令產生一組至少 32 字元的隨機字串
JWT_SECRET_KEY=請用上面的指令產生另一組至少 32 字元的隨機字串

# JWT 生命週期
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 資料庫（Postgres，async 驅動）---
# 注意 driver 是 postgresql+asyncpg，不是 postgresql 或 postgresql+psycopg2。
# 對應 docker-compose.yml 的預設帳密。
DATABASE_URL=postgresql+asyncpg://order_user:order_password_123@localhost:5432/online_ordering_system

# --- Redis（JWT blocklist + API 限流共用）---
REDIS_URL=redis://localhost:6379/0

# --- CORS：允許呼叫 API 的前端來源 ---
# JSON 陣列與逗號分隔兩種寫法都支援，擇一即可：
#   CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 注意 JSON 寫法必須用雙引號，單引號不是合法的 JSON。
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- 綠界（ECPay）測試環境 ---
# 2000132 / 5294y06JbISpM5x9 / v77hoKGq4kWxNNIS 為綠界官方公開的測試用金鑰。
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_RETURN_URL=https://your-ngrok-domain.ngrok-free.app/api/payment/ecpay/callback

# --- 背景排程 ---
# 訂單建立後超過這個分鐘數仍未付款，就自動取消並釋放庫存
UNPAID_ORDER_TIMEOUT_MINUTES=15
